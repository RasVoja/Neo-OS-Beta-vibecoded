#
# Boots Genode with one component, neo_hello, which runs a neo-rt program.
# Build the Rust part first: cargo build --release in genode/neo-hello.
#

build { core init lib/ld app/neo_hello }

create_boot_directory

install_config {
<config>
	<parent-provides>
		<service name="LOG"/>
		<service name="PD"/>
		<service name="CPU"/>
		<service name="ROM"/>
	</parent-provides>
	<default-route>
		<any-service> <parent/> </any-service>
	</default-route>
	<default caps="100"/>
	<start name="neo_hello">
		<resource name="RAM" quantum="2M"/>
	</start>
</config>}

build_boot_image [build_artifacts]

append qemu_args " -nographic "

run_genode_until {child "neo_hello" exited with exit value 0} 60
