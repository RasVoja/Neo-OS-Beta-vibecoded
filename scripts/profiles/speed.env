# Faster release build for the Lite ISO. UNTESTED: source it, build, then run
# the boot tests (scripts/test-boot-x86_64.sh and scripts/test-usb-x86_64.sh).
#   . scripts/profiles/speed.env && ./scripts/make-usb-image.sh
#
# These override the [profile.release] of Cargo.toml (opt-level "s").
# Do NOT add -C target-cpu=... here: the x86_64-unknown-none target is built
# without SSE and AVX, and CPU-specific flags can switch them on in code that
# runs before the kernel saves and restores that state. See docs/BUILD-ISO.md.
export CARGO_PROFILE_RELEASE_OPT_LEVEL=3
export CARGO_PROFILE_RELEASE_LTO=fat
export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
