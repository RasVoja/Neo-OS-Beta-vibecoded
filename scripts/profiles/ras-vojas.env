# Reference machine of the project owner. Source it, then build and boot.
#   . scripts/profiles/ras-vojas.env && ./scripts/make-usb-image.sh
#
# CPU     AMD Ryzen Threadripper PRO 3945WX (Zen 2), 12 cores / 24 threads
# Board   WRX80 Creator R2.0, UEFI, Windows 11 on NVMe
# Memory  64 GB
# Screen  Intel Arc B580, used through the UEFI GOP framebuffer only
# Storage NVMe 4 TB, hard disk 16 TB
# Network 2 x Marvell AQtion 10G, Intel AX210 Wi-Fi 6E (no drivers yet)
# Audio   Realtek USB audio (no driver yet)

. "$(dirname "$0")/speed.env" 2>/dev/null || . ./scripts/profiles/speed.env

# A QEMU machine that resembles it as far as the code can tell:
# Q35 chipset, UEFI firmware, USB 3 (xHCI) keyboard and mouse, 24 threads.
# UNTESTED. Set OVMF to your firmware file (for example /usr/share/OVMF/OVMF_CODE.fd).
export NEO_QEMU_REFERENCE="-machine q35 -cpu EPYC -smp 24 -m 4G \
  -drive if=pflash,format=raw,readonly=on,file=${OVMF:-OVMF_CODE.fd} \
  -device qemu-xhci -device usb-kbd -device usb-mouse \
  -cdrom target/neo-lite-x86_64.iso"
# Run it with: qemu-system-x86_64 $NEO_QEMU_REFERENCE
